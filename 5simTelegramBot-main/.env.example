# ═══════════════════════════════════════════════════════════════
# 5simTelegramBot — Environment Variables (.env.example)
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env:  cp .env.example .env
# Fill in real values. NEVER commit .env.

# ── Application Environment ────────────────────────────
APP_ENV=production

# ── Telegram Bot ────────────────────────────────────────
BOT_TOKEN=YOUR_BOT_TOKEN_HERE
ADMIN_IDS=8683874068
WEBHOOK_URL=https://abunumapp.com
WEBSITE_URL=https://abunumapp.com

# ── 5sim / HeroSMS API ─────────────────────────────────
HEROSMS_API_KEY=cb28fe1389Abce0053b2fb3bA48d6b4c
HEROSMS_API_URL=https://hero-sms.com/stubs/handler_api.php

# ── Payment: ZarinPal ──────────────────────────────────
ZARINPAL_MERCHANT=1344b5d4-0048-11e8-94db-005056a205be
ZARINPAL_SANDBOX=true

# ── Currency API (Navasan) ─────────────────────────────
NAVASAN_API_KEY=free26Ln3Pt7qXlEydjJYJEKDcjEYKuS

# ── Database: PostgreSQL ───────────────────────────────
DATABASE_URL=postgresql://smsbot:smsbot_secret@postgres:5432/smsbot

# ── Redis / Celery ─────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ── Flask / Gunicorn ───────────────────────────────────
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
SECRET_KEY=change-this-to-random-string

# ── Logging ────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Backup ─────────────────────────────────────────────
BACKUP_INTERVAL_SECONDS=300
BACKUP_FILE=data/users_backup.json

# ── Security ───────────────────────────────────────────
ADMIN_API_TOKEN=change-this-to-your-admin-token
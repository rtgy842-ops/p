# ═══════════════════════════════════════════════════════════════
# NumGenius — Environment Variables (.env.example)
# ═══════════════════════════════════════════════════════════════
# Copy to .env:  cp .env.example .env
# Fill in real values. NEVER commit .env to version control.

# ── Application Environment ────────────────────────────
APP_ENV=production

# ── Customer Bot ───────────────────────────────────────
BOT_TOKEN=YOUR_CUSTOMER_BOT_TOKEN_HERE
WEBHOOK_URL=https://yourdomain.com
WEBSITE_URL=https://yourdomain.com

# ── Admin Bot (SEPARATE token!) ────────────────────────
ADMIN_BOT_TOKEN=YOUR_ADMIN_BOT_TOKEN_HERE
ADMIN_IDS=YOUR_TELEGRAM_USER_ID
ADMIN_WEBHOOK_URL=https://yourdomain.com

# ── HeroSMS API ────────────────────────────────────────
HEROSMS_API_KEY=YOUR_HEROSMS_API_KEY
HEROSMS_API_URL=https://hero-sms.com/stubs/handler_api.php

# ── Payment: ZarinPal ──────────────────────────────────
ZARINPAL_MERCHANT=YOUR_ZARINPAL_MERCHANT_ID
ZARINPAL_SANDBOX=true

# ── Currency API (Navasan) ─────────────────────────────
NAVASAN_API_KEY=YOUR_NAVASAN_API_KEY

# ── Database: PostgreSQL ───────────────────────────────
DATABASE_URL=postgresql://smsbot:CHANGE_THIS_PASSWORD@postgres:5432/smsbot
POSTGRES_USER=smsbot
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD
POSTGRES_DB=smsbot

# ── Redis / Celery ─────────────────────────────────────
REDIS_PASSWORD=CHANGE_THIS_TO_YOUR_REDIS_PASSWORD
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@redis:6379/0

# ── Flask / Gunicorn ───────────────────────────────────
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING

# ── Admin Panel ────────────────────────────────────────
ADMIN_API_TOKEN=CHANGE_THIS_TO_YOUR_SECURE_ADMIN_TOKEN

# ── Logging ────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Backup ─────────────────────────────────────────────
BACKUP_INTERVAL_SECONDS=300
BACKUP_FILE=data/users_backup.json
BACKUP_DIR=data/backups
